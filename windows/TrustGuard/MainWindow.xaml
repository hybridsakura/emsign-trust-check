<Window x:Class="TrustGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrustGuard · 医院终端安全检测"
        Width="1180" Height="840" MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- 检查项卡片 -->
        <DataTemplate x:Key="CheckRowTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="13" Height="13" Fill="{Binding LightBrush}" VerticalAlignment="Top" Margin="0,5,0,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{Binding LightGlow}" BlurRadius="14" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <Border Background="{Binding SeverityBackground}" CornerRadius="7" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityBrush}" FontSize="11"/>
                            </Border>
                            <Border Background="{StaticResource ChipBrush}" CornerRadius="7" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding RelevanceText, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="{Binding RelevanceText}" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="12.5" Margin="0,6,0,0" LineHeight="20"/>

                        <Expander Margin="0,6,0,0">
                            <Expander.Header>
                                <TextBlock Text="可能影响与处置建议" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            </Expander.Header>
                            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Text="可能影响" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" FontSize="12" Foreground="#475569"
                                           Margin="0,2,0,8" LineHeight="19"/>
                                <TextBlock Text="处置建议" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" FontSize="12" Foreground="#475569"
                                           Margin="0,2,0,0" LineHeight="19"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                               FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 结论卡 -->
        <DataTemplate x:Key="VerdictTemplate">
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="54" Height="54" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Ellipse Fill="{Binding Light}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{Binding Glow}" BlurRadius="26" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="24" Height="24" Fill="#40FFFFFF"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CountsText}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#602563EB" BlurRadius="14" ShadowDepth="2"/>
                </Border.Effect>
                <Path Data="M21 11 L21 21 C21 26 18 29 13.5 31 C9 29 6 26 6 21 L6 11 L13.5 7.5 Z"
                      Fill="White" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold">
                    <Run Text="TrustGuard"/>
                    <Run Text="  医院终端安全检测" FontSize="13" FontWeight="Normal" Foreground="{StaticResource SubTextBrush}"/>
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis">
                    本地运行 · 不收集上传任何数据
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MachineName}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OsText}" FontSize="10.5" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="14" Padding="12,7" Margin="0,0,8,0" Background="#FEF3C7" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF3C7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding AdminText}" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B45309"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Foreground" Value="#15803D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Content="以管理员身份重启" Style="{StaticResource ElevateButton}" Command="{Binding ElevateCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="导出报告" Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="开始检测" Style="{StaticResource PrimaryButton}" Command="{Binding RunAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="emSign 证书漏洞">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ContentControl Content="{Binding EmSignVerdict}" ContentTemplate="{StaticResource VerdictTemplate}"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubTextBrush}" LineHeight="19">
                                判定逻辑：系统吊销列表（Disallowed CTL）与在线证书链探测共同判定。在线探测连接成功即表示本机仍信任被攻陷的中间 CA，可被实时中间人攻击；纯内网机器无法访问外网时，以吊销列表结果为准。
                            </TextBlock>
                        </Border>

                        <ItemsControl ItemsSource="{Binding EmSignChecks}" ItemTemplate="{StaticResource CheckRowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="医院业务场景风险">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="使用场景" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ProfileCombo}"
                                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="Name" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ProfileTip}" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource SubTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ContentControl Content="{Binding HospitalVerdict}" ContentTemplate="{StaticResource VerdictTemplate}"/>

                        <ItemsControl ItemsSource="{Binding HospitalView}" ItemTemplate="{StaticResource CheckRowTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,10,0,8">
                                                <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- footer -->
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusLine}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="离线检测脚本" Style="{StaticResource GhostButton}" Padding="12,6"
                        FontSize="11.5" Command="{Binding OpenOfflineScriptsCommand}" Margin="0,0,8,0"/>
                <TextBlock Text="检测结果仅供参考，请结合院内部署规范处置" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
