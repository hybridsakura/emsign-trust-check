<Window x:Class="TrustGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrustGuard.Views"
        Title="TrustGuard · 终端安全检测"
        Width="1180" Height="840" MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- 检查项卡片 -->
        <DataTemplate x:Key="CheckRowTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- flat status colour strip -->
                    <Border Background="{Binding StatusBrush}" CornerRadius="13,0,0,13"/>

                    <Grid Grid.Column="1" Margin="16,13,16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- status badge: tinted fill + crisp 1.5px border + glyph -->
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}"
                                BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,13,0">
                            <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="{Binding StatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <WrapPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#0B1220" VerticalAlignment="Center"/>
                                <Border Background="{Binding SeverityBackground}" BorderThickness="0"
                                        CornerRadius="6" Padding="7,1.5" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityBrush}"
                                               FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{Binding ActionBackground}" BorderBrush="{Binding ActionBorder}"
                                        BorderThickness="1" CornerRadius="6" Padding="7,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding ActionText, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Text="{Binding ActionText}" Foreground="{Binding ActionBrush}"
                                               FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="7,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding RelevanceText, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Text="{Binding RelevanceText}" Foreground="#64748B" FontSize="10.5"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#475569" FontSize="12.5"
                                       Margin="0,7,0,0" LineHeight="20"/>

                            <Expander Margin="0,8,0,0" IsExpanded="{Binding IsFail, Mode=OneWay}">
                                <Expander.Header>
                                    <TextBlock Text="查看影响与处置" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Expander.Header>
                                <StackPanel HorizontalAlignment="Stretch" Margin="0,2,24,0">
                                    <Border Background="#FFF9F3" BorderBrush="#F5DDC4" BorderThickness="1"
                                            CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Border Background="#FCE7CF" CornerRadius="6" Padding="8,1.5"
                                                    HorizontalAlignment="Left" Margin="0,0,0,7">
                                                <TextBlock Text="可能影响" FontSize="10.5" FontWeight="Bold" Foreground="#9A4A0B"/>
                                            </Border>
                                            <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" FontSize="12.5"
                                                       Foreground="#3D4452" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F4F8FF" BorderBrush="#D6E4FA" BorderThickness="1"
                                            CornerRadius="10" Padding="12,10">
                                        <StackPanel>
                                            <Border Background="#DBE9FD" CornerRadius="6" Padding="8,1.5"
                                                    HorizontalAlignment="Left" Margin="0,0,0,7">
                                                <TextBlock Text="处置建议" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                            <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" FontSize="12.5"
                                                       Foreground="#3D4452" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Border Grid.Column="2" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10,3" VerticalAlignment="Top" Margin="0,2,0,0">
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                       FontSize="11.5" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 结论卡 -->
        <DataTemplate x:Key="VerdictTemplate">
            <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="58" Height="58" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Ellipse Fill="{Binding Light}"/>
                        <Ellipse Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="2" Opacity="0.45" Margin="3"/>
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#0B1220"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="#475569"
                                   TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="20"/>

                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Border Background="#ECFDF3" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8"
                                    Padding="10,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding PassCount, StringFormat=通过 {0}}" Foreground="#15803D"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="8"
                                    Padding="10,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding FailCount, StringFormat=未通过 {0}}" Foreground="#B42318"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#FFFAEB" BorderBrush="#FEDF89" BorderThickness="1" CornerRadius="8"
                                    Padding="10,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding WarnCount, StringFormat=需关注 {0}}" Foreground="#B54708"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                    Padding="10,3" Visibility="{Binding ShowInfo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding InfoCount, StringFormat=提示 {0}}" Foreground="#475569"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#602563EB" BlurRadius="14" ShadowDepth="2"/>
                </Border.Effect>
                <Path Data="M21 11 L21 21 C21 26 18 29 13.5 31 C9 29 6 26 6 21 L6 11 L13.5 7.5 Z"
                      Fill="White" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold">
                    <Run Text="TrustGuard"/>
                    <Run x:Name="HeaderSuffix" Text="  终端安全检测" FontSize="13" FontWeight="Normal" Foreground="{StaticResource SubTextBrush}"/>
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis">
                    本地运行 · 不收集上传任何数据
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MachineName}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OsText}" FontSize="10.5" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="14" Padding="12,7" Margin="0,0,8,0" Background="#FEF3C7" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF3C7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding AdminText}" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B45309"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Foreground" Value="#15803D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Content="以管理员身份重启" Style="{StaticResource ElevateButton}" Command="{Binding ElevateCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="导出报告" Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="开始检测" Style="{StaticResource PrimaryButton}" Command="{Binding RunAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="emSign 证书漏洞">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ContentControl Content="{Binding EmSignVerdict}" ContentTemplate="{StaticResource VerdictTemplate}"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,14">
                            <StackPanel>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,1.5" HorizontalAlignment="Left" Margin="0,0,0,7">
                                    <TextBlock Text="判定逻辑" FontSize="10.5" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#4A5568" LineHeight="19">
                                    系统吊销列表（本机是否已收到微软的“不信任名单”）与在线证书链探测共同判定：前者决定断网时安不安全，后者回答此刻能不能被冒充。两项要合起来读。
                                </TextBlock>

                                <ToggleButton x:Name="ExplainToggle" Style="{StaticResource ExplainButton}" Margin="0,12,0,0"
                                              Content="📘 这个证书漏洞是怎么回事？（点开看通俗说明）">
                                    <ToggleButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                        </DataTemplate>
                                    </ToggleButton.ContentTemplate>
                                </ToggleButton>

                                <views:CertificateExplainer x:Name="ExplainPanel" Visibility="Collapsed" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding EmSignChecks}" ItemTemplate="{StaticResource CheckRowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ScenarioTab" Header="终端场景风险">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#EEF3FE" CornerRadius="6" Padding="9,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="使用场景" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                                <ComboBox Grid.Column="1" Style="{StaticResource ProfileCombo}"
                                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="Name" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ProfileTip}" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource SubTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ContentControl Content="{Binding ScenarioVerdict}" ContentTemplate="{StaticResource VerdictTemplate}"/>

                        <ItemsControl ItemsSource="{Binding ScenarioView}" ItemTemplate="{StaticResource CheckRowTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8EFFE" CornerRadius="8" Padding="10,2" HorizontalAlignment="Left"
                                                    Margin="2,12,0,9">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                                             Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- footer -->
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusLine}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="离线检测脚本" Style="{StaticResource GhostButton}" Padding="12,6"
                        FontSize="11.5" Command="{Binding OpenOfflineScriptsCommand}" Margin="0,0,8,0"/>
                <TextBlock Text="检测结果仅供参考，请结合本单位安全规范处置" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- internal build only: organisation footer / signature / tech support -->
        <Border x:Name="BrandFooter" Grid.Row="3" Margin="0,8,0,0" Padding="0,7,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock x:Name="FooterOrgText" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                <TextBlock x:Name="FooterSignerText" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                <TextBlock x:Name="FooterTechText" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,1,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
