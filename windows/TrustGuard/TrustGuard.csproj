<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrustGuard</AssemblyName>
    <RootNamespace>TrustGuard</RootNamespace>
    <Version>1.0.0</Version>
    <Product>TrustGuard 终端安全检测</Product>
    <Company>TrustGuard</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Self-contained single file: no .NET runtime required on target machines -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Variant=Internal compiles the local, git-ignored branding file (organisation footer, names). -->
  <PropertyGroup Condition="'$(Variant)' == ''">
    <Variant>Public</Variant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Variant)' == 'Internal'">
    <DefineConstants>$(DefineConstants);INTERNAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Branding\InternalBranding.local.cs" />
    <Compile Include="Branding\InternalBranding.local.cs" Condition="'$(Variant)' == 'Internal'" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
